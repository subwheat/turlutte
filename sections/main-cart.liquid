<section class="page page--etroite panier">
  <h1 class="page__titre">Panier</h1>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post">
      <ul class="lignes" role="list">
        {%- for item in cart.items -%}
          <li class="ligne">
            <a class="ligne__image" href="{{ item.url }}">{% render 'visuel', image: item.image, nom: 'Packshot', ratio: '4/5', tailles: '120px' %}</a>
            <div class="ligne__infos">
              <a class="ligne__nom" href="{{ item.url }}">{{ item.product.title | escape }}</a>
              {%- unless item.product.has_only_default_variant -%}<p class="ligne__variante">{{ item.variant.title | escape }}</p>{%- endunless -%}
              <label class="ligne__quantite">Quantité
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"{% if settings.une_piece_par_commande %} max="1"{% endif %}>
              </label>
              <a href="{{ item.url_to_remove }}">Retirer</a>
            </div>
            <p class="ligne__prix">{{ item.final_line_price | money }}</p>
          </li>
        {%- endfor -%}
      </ul>
      <p class="tiroir__total"><span>Total</span> <span>{{ cart.total_price | money }}</span></p>
      <p class="tiroir__port">{{ settings.texte_port }}</p>
      <p class="tiroir__port">{{ settings.texte_hors_ue }}</p>
      <div class="panier__actions">
        <button type="submit" name="update" class="bouton">Mettre à jour</button>
        <button type="submit" name="checkout" class="bouton bouton--plein">Payer</button>
      </div>
    </form>
  {%- else -%}
    <p>Rien pour l’instant. On ne dira rien.</p>
    <a class="bouton" href="{{ routes.all_products_collection_url }}">Voir les pièces</a>
  {%- endif -%}
</section>

{% schema %}
{ "name": "Panier" }
{% endschema %}
