{%- comment -%} Bloc 1 de l'accueil : photo de campagne plein écran, jour (lumière douce) et nuit (flash). {%- endcomment -%}
<section class="ouverture" aria-labelledby="ouverture-{{ section.id }}">
  <div class="ouverture__image seul-jour-image">
    {% render 'visuel', image: section.settings.image_jour, nom: 'Campagne accueil, jour : porté, lumière douce', ratio: section.settings.ratio, tailles: '100vw', prioritaire: true %}
  </div>
  <div class="ouverture__image seule-nuit-image">
    {% render 'visuel', image: section.settings.image_nuit, nom: 'Campagne accueil, nuit : porté au flash', ratio: section.settings.ratio, tailles: '100vw' %}
  </div>
  <div class="ouverture__texte">
    <h1 id="ouverture-{{ section.id }}" class="ouverture__accroche">
      <span class="seul-jour">{{ section.settings.accroche_jour }}</span>
      <span class="seule-nuit">{{ section.settings.accroche_nuit | default: section.settings.accroche_jour }}</span>
    </h1>
    {%- if section.settings.bouton != blank -%}
      <a class="bouton" href="{{ section.settings.lien | default: routes.all_products_collection_url }}">{{ section.settings.bouton }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ouverture",
  "settings": [
    { "type": "image_picker", "id": "image_jour", "label": "Photo de campagne, jour" },
    { "type": "image_picker", "id": "image_nuit", "label": "Photo de campagne, nuit (flash)" },
    { "type": "select", "id": "ratio", "label": "Format", "default": "3/4", "options": [ { "value": "3/4", "label": "3:4" }, { "value": "16/9", "label": "16:9" }, { "value": "plein", "label": "Plein écran" } ] },
    { "type": "text", "id": "accroche_jour", "label": "Accroche, jour", "default": "La tenue est irréprochable." },
    { "type": "text", "id": "accroche_nuit", "label": "Accroche, nuit", "default": "La réputation nous précède." },
    { "type": "text", "id": "bouton", "label": "Bouton", "default": "Voir les pièces" },
    { "type": "url", "id": "lien", "label": "Lien du bouton" }
  ],
  "presets": [{ "name": "Ouverture" }]
}
{% endschema %}
