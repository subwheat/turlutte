<section class="vice vice--court">
  <p class="vice__surtitre">{{ shop.name }}</p>
  <h1 class="vice__titre">{{ section.settings.titre }}</h1>
  {%- if shop.password_message != blank -%}<p class="vice__chapo">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer', class: 'formulaire-ligne' -%}
    <input type="hidden" name="contact[tags]" value="newsletter, prelancement">
    <label class="visuellement-cache" for="pw-email">E-mail</label>
    <input id="pw-email" type="email" name="contact[email]" placeholder="Votre e-mail" required>
    <button type="submit">Être prévenu</button>
    {%- if form.posted_successfully? -%}<p class="formulaire__ok" role="status">C'est noté. On ne dira rien.</p>{%- endif -%}
  {%- endform -%}
  <details class="vice__connexion">
    <summary>Entrer avec le mot de passe</summary>
    {%- form 'storefront_password' -%}
      <label for="pw">Mot de passe</label>
      <input id="pw" type="password" name="password" autocomplete="current-password">
      <button type="submit">Entrer</button>
      {%- if form.errors -%}<p class="formulaire__erreur" role="alert">Ce n’est pas le bon.</p>{%- endif -%}
    {%- endform -%}
  </details>
</section>

{% schema %}
{
  "name": "Page d'attente",
  "settings": [ { "type": "text", "id": "titre", "label": "Titre", "default": "Bientôt. Ceux qui savent sont prévenus en premier." } ]
}
{% endschema %}
