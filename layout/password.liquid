<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-state="nuit">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ shop.name }}</title>
    <style>
      @font-face { font-family: 'Libre Caslon Display'; src: url('{{ 'caslon-display-400.woff2' | asset_url }}') format('woff2'); font-display: swap; }
      @font-face { font-family: 'Libre Caslon Text'; src: url('{{ 'caslon-text-400.woff2' | asset_url }}') format('woff2'); font-display: swap; }
      @font-face { font-family: 'Libre Caslon Text'; src: url('{{ 'caslon-text-400-italic.woff2' | asset_url }}') format('woff2'); font-style: italic; font-display: swap; }
      :root { --creme: {{ settings.couleur_creme }}; --bleu: {{ settings.couleur_bleu }}; --phosphore: {{ settings.couleur_phosphore }}; }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="gabarit-password">
    <main id="contenu">{{ content_for_layout }}</main>
  </body>
</html>
