<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>Carte cadeau · {{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="page page--etroite">
      <h1 class="page__titre">Carte cadeau {{ shop.name }}</h1>
      <p class="fiche__prix">{{ gift_card.balance | money }}</p>
      {%- if gift_card.enabled == false or gift_card.expired -%}<p>Cette carte n’est plus valable.</p>{%- endif -%}
      <p>Code : <strong>{{ gift_card.code | format_code }}</strong></p>
      <a class="bouton" href="{{ shop.url }}">Aller à la boutique</a>
    </main>
  </body>
</html>
