{%- comment -%}
  Une image, ou un emplacement réservé tant que le visuel ChatGPT n'est pas livré.
  - image : objet image ou media (facultatif)
  - nom : ce qui doit venir ici, affiché dans l'emplacement (ex. « Packshot face, jour »)
  - ratio : '4/5' (fiches, grilles), '3/4', '16/9' ou 'plein' (campagne)
  - tailles : attribut sizes
  - prioritaire : true pour l'image au-dessus de la ligne de flottaison
  - classe : classe supplémentaire
{%- endcomment -%}
{%- liquid
  assign r = ratio | default: '4/5'
  assign t = tailles | default: '(min-width: 990px) 25vw, 50vw'
-%}
<figure class="visuel {{ classe }}" style="--ratio: {% if r == 'plein' %}auto{% else %}{{ r }}{% endif %};"{% if r == 'plein' %} data-plein{% endif %}>
  {%- if image != blank -%}
    {%- if prioritaire -%}
      {{ image | image_url: width: 2000 | image_tag: widths: '400, 600, 800, 1000, 1400, 2000', sizes: t, loading: 'eager', fetchpriority: 'high', alt: image.alt | escape }}
    {%- else -%}
      {{ image | image_url: width: 2000 | image_tag: widths: '400, 600, 800, 1000, 1400, 2000', sizes: t, loading: 'lazy', alt: image.alt | escape }}
    {%- endif -%}
  {%- else -%}
    <div class="emplacement" role="img" aria-label="Visuel à venir : {{ nom | escape }}">
      <svg class="emplacement__hamecon" viewBox="0 0 40 80" aria-hidden="true"><path d="M22 4v46c0 10-6 18-14 18S-2 60 2 52" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M2 52l8 2" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><circle cx="22" cy="4" r="3" fill="none" stroke="currentColor" stroke-width="2"/></svg>
      <span class="emplacement__nom">{{ nom | default: 'Visuel à venir' }}</span>
      <span class="emplacement__format">{{ r | replace: '/', ':' }}</span>
    </div>
  {%- endif -%}
</figure>
